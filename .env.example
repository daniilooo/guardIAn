# guardIAn — copie para .env e preencha. O arquivo .env NUNCA deve ser commitado.

# Chave da API TypeSafe (JEV) — https://docs.typesafe.ai
TYPESAFE_API_KEY=

# Modelo do JEV
JEV_MODEL=jev-latest
# Tempo máximo de uma avaliação antes de considerar o JEV indisponível (ms)
JEV_TIMEOUT_MS=10000

# Servidor local (somente loopback)
GUARDIAN_HOST=127.0.0.1
GUARDIAN_PORT=7070

# Caminho do banco SQLite
GUARDIAN_DB_PATH=./data/guardian.db

# trace | debug | info | warn | error
LOG_LEVEL=info
