{
  "name": "guardian",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.11.2",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "pnpm --filter @guardian/web build && node --env-file-if-exists=.env apps/server/src/main.ts",
    "dev": "node --watch --env-file-if-exists=.env apps/server/src/main.ts",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r --if-present typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm -r --if-present build",
    "check:secrets": "node scripts/check-secrets.ts",
    "prepare": "lefthook install",
    "dev:web": "pnpm --filter @guardian/web dev"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "lefthook": "^2.2.1",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
